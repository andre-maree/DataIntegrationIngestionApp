{
    "version": "2.0",
    "logging": {
        "applicationInsights": {
            "samplingSettings": {
                "isEnabled": true,
                "excludedTypes": "Request"
            },
            "enableLiveMetricsFilters": true
        }
    },
    "extensions": {
        "serviceBus": {
            "maxConcurrentSessions": 8,
            "sessionIdleTimeout": "00:01:00",
            "maxAutoLockRenewalDuration": "00:10:00",
            "prefetchCount": 0,
            "maxConcurrentCallsPerSession": 1,
            "maxMessageBatchSize": 1
        }
    }
}